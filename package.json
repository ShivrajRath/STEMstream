{
  "name": "stemstream",
  "private": true,
  "version": "1.0.0",
  "description": "A curated, static STEM video library built with React, Vite and Tailwind CSS.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "content:check": "python3 scripts/update_content.py --check",
    "content:audit": "python3 scripts/update_content.py --check --check-links"
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.5"
  }
}
