<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive foreground for API 26+. Everything must stay inside the central
    66dp of the 108dp canvas (21..87), because launchers crop this layer to a
    circle, squircle or rounded square. The orbits previously ran from 20 to 88,
    so every mask sliced them off.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54">
        <path
            android:fillColor="#00000000"
            android:pathData="M27.5,54 C27.5,48.4 39.4,43.9 54,43.9 C68.7,43.9 80.5,48.4 80.5,54 C80.5,59.6 68.7,64.1 54,64.1 C39.4,64.1 27.5,59.6 27.5,54 Z"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.4" />
    </group>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="60">
        <path
            android:fillColor="#00000000"
            android:pathData="M27.5,54 C27.5,48.4 39.4,43.9 54,43.9 C68.7,43.9 80.5,48.4 80.5,54 C80.5,59.6 68.7,64.1 54,64.1 C39.4,64.1 27.5,59.6 27.5,54 Z"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.4" />
    </group>

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="120">
        <path
            android:fillColor="#00000000"
            android:pathData="M27.5,54 C27.5,48.4 39.4,43.9 54,43.9 C68.7,43.9 80.5,48.4 80.5,54 C80.5,59.6 68.7,64.1 54,64.1 C39.4,64.1 27.5,59.6 27.5,54 Z"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.4" />
    </group>

    <!-- Dark disc so the nucleus stays readable where the orbits cross. -->
    <path
        android:fillColor="#FF08090A"
        android:pathData="M54,48.6 A5.4,5.4 0 1,0 54,59.4 A5.4,5.4 0 1,0 54,48.6 Z" />

    <path
        android:fillColor="#FFFF2D55"
        android:pathData="M54,49.7 A4.3,4.3 0 1,0 54,58.3 A4.3,4.3 0 1,0 54,49.7 Z" />
</vector>
